# checkout-bridge: variáveis de ambiente.
# Copie para .env e preencha. Nunca versione o .env: ele contém segredos.
# `npm start` lê o .env do diretório atual, se existir; no Docker use `docker run --env-file .env`.
# As três variáveis obrigatórias (PUBLIC_BASE_URL, ENCRYPTION_KEY, ADMIN_PASSWORD) vêm vazias: o serviço não sobe sem elas.
# Cada variável aqui corresponde a uma entrada em src/config.ts.

# Ambiente de execução: development, production ou test. Em production, PUBLIC_BASE_URL precisa ser https.
NODE_ENV=production

# Interface e porta em que o processo escuta.
HOST=0.0.0.0
PORT=8787

# URL pública https do serviço, sem barra final. Usada nos webhooks, no App Proxy e nos cookies do painel.
PUBLIC_BASE_URL=https://bridge.exemplo.com.br

# Caminho do arquivo SQLite. Precisa ficar em disco persistente (no Docker, dentro do volume /app/data).
DATABASE_PATH=./data/bridge.db

# 32 bytes em base64 que cifram os segredos das lojas guardados no banco. Gere com: openssl rand -base64 32
# Guarde uma cópia fora do servidor: sem esta chave os segredos do banco ficam ilegíveis.
ENCRYPTION_KEY=

# Senha do painel em /admin. Obrigatória, mínimo de 12 caracteres; use uma senha longa e única (a senha de exemplo
# de versões anteriores deste arquivo é recusada).
ADMIN_PASSWORD=

# Versão da Admin API e da Storefront API (formato AAAA-MM). 2026-10 é servida até 16/10/2027.
SHOPIFY_API_VERSION=2026-10

# Quantos proxies confiáveis (proxy reverso, CDN) existem entre a internet e este processo. Cada um acrescenta o IP
# de quem o chamou ao FIM de X-Forwarded-For e preserva o que já vinha; o serviço conta essa quantidade a partir da
# direita para achar o IP do cliente e ignora o que estiver mais à esquerda (que o próprio cliente pode ter escrito).
# 1 = um proxy reverso (nginx, Caddy, Traefik ou Cloudflare); 2 = CDN + proxy; 0 = processo exposto direto. Entre 0 e 10.
TRUSTED_PROXY_HOPS=1

# Idade máxima, em segundos, do timestamp assinado pelo App Proxy (proteção contra replay). Entre 10 e 600.
PROXY_SIGNATURE_MAX_AGE_SECONDS=90

# Janela de idempotência, em minutos: o mesmo carrinho reaproveita o mesmo checkout nesse período. Entre 1 e 1440.
SESSION_TTL_MINUTES=15

# Limites de taxa do App Proxy, por minuto: por IP do comprador e por loja vitrine.
RATE_LIMIT_PER_IP_PER_MINUTE=20
RATE_LIMIT_PER_SHOP_PER_MINUTE=600

# Tempo limite, em milissegundos, de cada chamada à Shopify. Entre 500 e 60000.
UPSTREAM_TIMEOUT_MS=6000

# Intervalo, em minutos, da ressincronização completa dos catálogos. 0 desliga o agendamento.
CATALOG_RESYNC_MINUTES=360

# Dias de retenção das sessões de checkout e da auditoria. Entre 1 e 3650.
RETENTION_DAYS=90

# Opcional: webhook (Slack, Discord ou genérico) que recebe os alertas em JSON. Vazio desliga o envio.
ALERT_WEBHOOK_URL=

# Opcional: token exigido em /metrics (cabeçalho "Authorization: Bearer <token>"). Vazio deixa a rota aberta.
METRICS_TOKEN=

# Nível de log: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info
